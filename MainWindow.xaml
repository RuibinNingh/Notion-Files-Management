<ui:FluentWindow x:Class="Notion_Files_Management.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:views="clr-namespace:Notion_Files_Management.Views"
        Title="Notion-Files-Management" Height="600" Width="1000"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica" 
        WindowStartupLocation="CenterScreen"
        Icon="icon.ico">
	<!-- 这里仍然要设置窗口图标 -->

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>

		<!-- 自定义 TitleBar，在其中手动添加图标 -->
		<ui:TitleBar Grid.Row="0" 
                      Title="Notion-Files-Management" 
                      Background="Transparent" 
                      Height="32">

			<!-- 在 TitleBar 的 Header 中添加图标 -->
			<ui:TitleBar.Header>
				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="Auto" />
						<ColumnDefinition Width="Auto" />
					</Grid.ColumnDefinitions>

					<!-- 图标 -->
					<Image Grid.Column="0"
                           Source="icon.ico"
                           Width="32"
                           Height="32"
                           Margin="10,0,8,0"
                           VerticalAlignment="Center" />

					<!-- 标题文本 -->
					<TextBlock Grid.Column="1"
				               Text="Notion-Files-Management"
				               VerticalAlignment="Center"
				               FontSize="14"
				               FontWeight="SemiBold"
				               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
				</Grid>
			</ui:TitleBar.Header>

		</ui:TitleBar>

		<ui:NavigationView x:Name="RootNavigation" 
                            Grid.Row="1"
                            PaneDisplayMode="Left"
                            OpenPaneLength="200"
                            IsBackButtonVisible="Collapsed">

				<ui:NavigationView.Resources>
					<Style TargetType="{x:Type ui:NavigationViewItem}">
						<Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
					</Style>
				</ui:NavigationView.Resources>

			<ui:NavigationView.MenuItems>
				<ui:NavigationViewItem Content="主页" Icon="{ui:SymbolIcon Home24}" TargetPageType="{x:Type views:DashboardPage}" />
				<ui:NavigationViewItem Content="上传" Icon="{ui:SymbolIcon ArrowUpload24}" TargetPageType="{x:Type views:UploadPage}" />
				<ui:NavigationViewItem Content="下载" Icon="{ui:SymbolIcon ArrowDownload24}" TargetPageType="{x:Type views:DownloadPage}" />
				<ui:NavigationViewItem Content="工具箱" Icon="{ui:SymbolIcon Toolbox24}" TargetPageType="{x:Type views:ToolsPage}" />
			</ui:NavigationView.MenuItems>

			<ui:NavigationView.FooterMenuItems>
				<ui:NavigationViewItem Content="设置" Icon="{ui:SymbolIcon Settings24}" TargetPageType="{x:Type views:SettingsPage}" />
			</ui:NavigationView.FooterMenuItems>
		</ui:NavigationView>
	</Grid>
</ui:FluentWindow>