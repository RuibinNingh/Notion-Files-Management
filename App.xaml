<Application x:Class="Notion_Files_Management.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:Primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
             StartupUri="MainWindow.xaml">
	<Application.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ui:ThemesDictionary Theme="Dark" />
				<ui:ControlsDictionary />
			</ResourceDictionary.MergedDictionaries>

			<Color x:Key="SystemAccentColor">#1E90FF</Color>
			<Color x:Key="SystemAccentColorLight1">#1E90FF</Color>
			<Color x:Key="SystemAccentColorLight2">#1E90FF</Color>
				<Color x:Key="SystemAccentColorLight3">#1E90FF</Color>

				<SolidColorBrush x:Key="SystemAccentColorBrush" Color="#1E90FF" />
				<SolidColorBrush x:Key="SystemAccentColorLight1Brush" Color="#1E90FF" />
				<SolidColorBrush x:Key="SystemAccentColorLight2Brush" Color="#1E90FF" />
				<SolidColorBrush x:Key="SystemAccentColorLight3Brush" Color="#1E90FF" />

				<SolidColorBrush x:Key="ControlStrongFillColorDefaultBrush" Color="#1E90FF" />
				<Style TargetType="{x:Type ui:SymbolIcon}">
					<Setter Property="Foreground" Value="{ui:ThemeResource TextFillColorPrimaryBrush}"/>
				</Style>
				<Style TargetType="{x:Type ui:FontIcon}">
					<Setter Property="Foreground" Value="{ui:ThemeResource TextFillColorPrimaryBrush}"/>
				</Style>

				<Style TargetType="{x:Type ui:SymbolIcon}" x:Key="InputIconStyle">
					<Setter Property="Foreground" Value="{ui:ThemeResource TextFillColorPrimaryBrush}"/>
				</Style>
				<Style TargetType="{x:Type ui:FontIcon}" x:Key="InputFontIconStyle">
					<Setter Property="Foreground" Value="{ui:ThemeResource TextFillColorPrimaryBrush}"/>
				</Style>

				<Style TargetType="{x:Type ui:SymbolIcon}" x:Key="ButtonInlineIconStyle">
					<Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Primitives:ButtonBase}}}"/>
				</Style>
				<Style TargetType="{x:Type ui:FontIcon}" x:Key="ButtonInlineFontIconStyle">
					<Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Primitives:ButtonBase}}}"/>
				</Style>

				<Style x:Key="BluePrimaryUiButton"
                   TargetType="{x:Type ui:Button}"
                   BasedOn="{StaticResource {x:Type ui:Button}}">
					<Setter Property="Appearance" Value="Primary"/>
					<Setter Property="Background" Value="{StaticResource SystemAccentColorBrush}"/>
					<Setter Property="BorderBrush" Value="{StaticResource SystemAccentColorBrush}"/>
					<Setter Property="Foreground" Value="White"/>

					<Style.Triggers>
						<Trigger Property="IsMouseOver" Value="True">
						<Setter Property="Background" Value="#3FA2FF"/>
							<Setter Property="BorderBrush" Value="#3FA2FF"/>
						</Trigger>
					</Style.Triggers>
				</Style>

				<Style TargetType="{x:Type TextBlock}">
					<Setter Property="Foreground" Value="{ui:ThemeResource TextFillColorPrimaryBrush}" />
				</Style>

				<Style TargetType="{x:Type Label}">
					<Setter Property="Foreground" Value="{ui:ThemeResource TextFillColorPrimaryBrush}" />
				</Style>
		</ResourceDictionary>
	</Application.Resources>
</Application>