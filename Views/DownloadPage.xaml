<Page x:Class="Notion_Files_Management.Views.DownloadPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="下载">

	<Page.Resources>
		<SolidColorBrush x:Key="StatusCompletedBrush" Color="#4CAF50"/>
		<SolidColorBrush x:Key="StatusErrorBrush"     Color="#EF5350"/>
		<SolidColorBrush x:Key="StatusWaitingBrush"    Color="#78909C"/>
	</Page.Resources>

	<Grid>
		<Grid Margin="30" VerticalAlignment="Top">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
			</Grid.RowDefinitions>

			<!-- 顶部标题 -->
			<StackPanel Grid.Row="0" HorizontalAlignment="Left" Orientation="Horizontal" Margin="0,0,0,12">
				<ui:SymbolIcon Symbol="ArrowDownload24" FontSize="32" Margin="0,0,15,0"/>
				<ui:TextBlock Text="文件下载 Download"
				              FontTypography="Title"
				              VerticalAlignment="Center"
				              Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
			</StackPanel>

			<!-- 中间卡片 -->
			<ui:Card Grid.Row="1" Padding="20">
				<StackPanel>
					<ui:Button x:Name="BtnOpenDownloadDialog"
							   Style="{StaticResource BluePrimaryUiButton}"
							   Content="下载新文件"
							   Icon="{ui:SymbolIcon Symbol=Add24}"
							   Click="BtnOpenDownloadDialog_Click" />

					<ui:TextBlock Text="活动下载任务"
							  Appearance="Tertiary"
							  Margin="0,20,0,8"/>

					<Border BorderBrush="{DynamicResource ControlElevationBorderBrush}"
							BorderThickness="1"
							CornerRadius="8">
						<ListView x:Name="DownloadTaskListView"
								     ItemsSource="{Binding DisplayTasks}"
								     MinHeight="200"
								     MaxHeight="520"
								     Background="Transparent"
								     Foreground="{DynamicResource TextFillColorPrimaryBrush}"
								     HorizontalContentAlignment="Stretch"
								     ScrollViewer.VerticalScrollBarVisibility="Auto"
								     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
							<ListView.ItemContainerStyle>
								<Style TargetType="ListViewItem">
									<Setter Property="HorizontalContentAlignment" Value="Stretch"/>
									<Setter Property="Padding" Value="0"/>
									<Setter Property="Margin" Value="0"/>
								</Style>
							</ListView.ItemContainerStyle>
							<ListView.ItemTemplate>
								<DataTemplate>
									<Border CornerRadius="8"
									        Padding="14,10"
									        Margin="4,3"
									        Background="{DynamicResource ControlFillColorDefaultBrush}">
										<StackPanel>
											<!-- 第一行: 状态图标 + 文件名（左）  百分比 + 速度（右） -->
											<Grid Margin="0,0,0,8">
												<Grid.ColumnDefinitions>
													<ColumnDefinition Width="*"/>
													<ColumnDefinition Width="Auto"/>
												</Grid.ColumnDefinitions>

												<StackPanel Orientation="Horizontal"
												            VerticalAlignment="Center"
												            Grid.Column="0">
													<ui:SymbolIcon FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center">
														<ui:SymbolIcon.Style>
															<Style TargetType="ui:SymbolIcon">
																<Setter Property="Symbol" Value="ArrowDownload24"/>
																<Setter Property="Foreground" Value="{DynamicResource SystemAccentColorBrush}"/>
																<Style.Triggers>
																	<DataTrigger Binding="{Binding status}" Value="completed">
																		<Setter Property="Symbol" Value="CheckmarkCircle24"/>
																		<Setter Property="Foreground" Value="{StaticResource StatusCompletedBrush}"/>
																	</DataTrigger>
																	<DataTrigger Binding="{Binding status}" Value="error">
																		<Setter Property="Symbol" Value="DismissCircle24"/>
																		<Setter Property="Foreground" Value="{StaticResource StatusErrorBrush}"/>
																	</DataTrigger>
																	<DataTrigger Binding="{Binding status}" Value="waiting">
																		<Setter Property="Symbol" Value="Clock24"/>
																		<Setter Property="Foreground" Value="{StaticResource StatusWaitingBrush}"/>
																	</DataTrigger>
																</Style.Triggers>
															</Style>
														</ui:SymbolIcon.Style>
													</ui:SymbolIcon>

													<TextBlock Text="{Binding real_name}"
													           FontWeight="SemiBold"
													           FontSize="13"
													           TextTrimming="CharacterEllipsis"
													           VerticalAlignment="Center"/>
												</StackPanel>

												<StackPanel Orientation="Horizontal"
												            Grid.Column="1"
												            VerticalAlignment="Center">
													<TextBlock Text="{Binding progress, StringFormat={}{0:0}%}"
													           FontSize="14"
													           FontWeight="Bold"
													           Margin="12,0,12,0"
													           VerticalAlignment="Center">
														<TextBlock.Style>
															<Style TargetType="TextBlock">
																<Setter Property="Foreground" Value="{DynamicResource SystemAccentColorBrush}"/>
																<Style.Triggers>
																	<DataTrigger Binding="{Binding status}" Value="completed">
																		<Setter Property="Foreground" Value="{StaticResource StatusCompletedBrush}"/>
																	</DataTrigger>
																	<DataTrigger Binding="{Binding status}" Value="error">
																		<Setter Property="Foreground" Value="{StaticResource StatusErrorBrush}"/>
																	</DataTrigger>
																</Style.Triggers>
															</Style>
														</TextBlock.Style>
													</TextBlock>

													<TextBlock Text="{Binding speed_mb_s, StringFormat={}{0:0.0} MB/s}"
													           FontSize="12"
													           VerticalAlignment="Center"
													           Foreground="{DynamicResource SystemAccentColorBrush}"/>
												</StackPanel>
											</Grid>

											<!-- 第二行: 全宽进度条 -->
											<ProgressBar Value="{Binding progress}"
											             Maximum="100"
											             Height="8"
											             Margin="0,0,0,6"
											             HorizontalAlignment="Stretch">
												<ProgressBar.Style>
													<Style TargetType="ProgressBar">
														<Setter Property="Foreground" Value="{DynamicResource SystemAccentColorBrush}"/>
														<Style.Triggers>
															<DataTrigger Binding="{Binding status}" Value="completed">
																<Setter Property="Foreground" Value="{StaticResource StatusCompletedBrush}"/>
															</DataTrigger>
															<DataTrigger Binding="{Binding status}" Value="error">
																<Setter Property="Foreground" Value="{StaticResource StatusErrorBrush}"/>
															</DataTrigger>
															<DataTrigger Binding="{Binding status}" Value="waiting">
																<Setter Property="Foreground" Value="{StaticResource StatusWaitingBrush}"/>
															</DataTrigger>
														</Style.Triggers>
													</Style>
												</ProgressBar.Style>
											</ProgressBar>

											<!-- 第三行: 大小详情（左）+ 剩余时间（右） -->
											<Grid>
												<Grid.ColumnDefinitions>
													<ColumnDefinition Width="*"/>
													<ColumnDefinition Width="Auto"/>
												</Grid.ColumnDefinitions>

												<StackPanel Orientation="Horizontal" Grid.Column="0">
													<TextBlock Text="{Binding downloaded_mb, StringFormat={}{0:0.0} MB}"
													           FontSize="11"
													           Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
													<TextBlock Text="{Binding total_mb, StringFormat={} / {0:0.0} MB}"
													           FontSize="11"
													           Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
													<TextBlock Text="{Binding status, StringFormat={} · {0}}"
													           FontSize="11"
													           Margin="4,0,0,0"
													           Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
												</StackPanel>

												<TextBlock Grid.Column="1"
												           Text="{Binding ETA, StringFormat=剩余 {0}s}"
												           FontSize="11"
												           Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
											</Grid>
										</StackPanel>
									</Border>
								</DataTemplate>
							</ListView.ItemTemplate>
						</ListView>
					</Border>
				</StackPanel>
			</ui:Card>

			<Grid Grid.Row="2" />
		</Grid>

		<!-- ========== 模态层（保持不变） ========== -->
		<Grid x:Name="ModalOverlay" Background="#99000000" Visibility="Collapsed">

			<ui:Card x:Name="ModalStep1" Background="#ff222329" Width="420" VerticalAlignment="Center" Visibility="Collapsed">
				<StackPanel Margin="10">
					<ui:TextBlock Text="获取 Notion 内容" FontTypography="Subtitle" Margin="0,0,0,15"/>
					<ui:TextBlock Text="请输入目标页面 ID" Appearance="Tertiary" Margin="0,0,0,8"/>
					<Grid>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*"/>
							<ColumnDefinition Width="Auto"/>
						</Grid.ColumnDefinitions>
						<ui:TextBox x:Name="PageIdInput" PlaceholderText="粘贴 Notion 页面 ID" TextChanged="PageIdInput_TextChanged"/>
						<ui:Button x:Name="BtnConfirmId" 
           Grid.Column="1" 
           Content="获取列表" 
           Style="{StaticResource BluePrimaryUiButton}" 
           Margin="10,0,0,0" 
           Click="ConfirmId_Click"/>
					</Grid>

					<ui:TextBlock x:Name="PageIdErrorText"
							 Text=""
							 FontSize="12"
							 Margin="0,6,0,0"
							 Foreground="#FFEF5350"/>
					<ui:Button Content="取消" HorizontalAlignment="Right" Margin="0,20,0,0" Click="CloseModal_Click"/>
				</StackPanel>
			</ui:Card>

			<ui:Card x:Name="ModalStep2" Background="#ff222329" Width="600" VerticalAlignment="Center" Visibility="Collapsed">
				<StackPanel Margin="10">
					<ui:TextBlock Text="选择下载项" FontTypography="Subtitle" Margin="0,0,0,15"/>

					<Border BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1" CornerRadius="4" Margin="0,0,0,15">
						<ListView x:Name="FileListSelector"
          Height="280"
          ScrollViewer.VerticalScrollBarVisibility="Auto"
          Background="Transparent"
          Foreground="{DynamicResource TextFillColorPrimaryBrush}">
							<ListView.ItemTemplate>
								<DataTemplate>
									<CheckBox IsChecked="{Binding IsSelected}"
                      Content="{Binding real_name}"
                      VerticalContentAlignment="Center"
                      Margin="0,2"
                      Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
								</DataTemplate>
							</ListView.ItemTemplate>
						</ListView>
					</Border>

					<ui:TextBlock Text="下载至" Appearance="Tertiary" Margin="0,0,0,8"/>
					<Grid Margin="0,0,0,20">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*"/>
							<ColumnDefinition Width="Auto"/>
						</Grid.ColumnDefinitions>
						<ui:TextBox x:Name="SavePathDisplay" IsReadOnly="True" PlaceholderText="请选择保存目录..."/>
						<ui:Button Grid.Column="1" Content="浏览" Margin="10,0,0,0" Click="SelectFolder_Click"/>
					</Grid>

					<Grid>
						<StackPanel Orientation="Horizontal">
							<ui:Button Content="全选" Margin="0,0,8,0" Click="SelectAll_Click"/>
							<ui:Button Content="反选" Click="InvertSelect_Click"/>
						</StackPanel>
						<StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
							<ui:Button Content="返回" Margin="0,0,8,0" Click="BackToStep1_Click"/>
							<ui:Button Content="开始下载任务" Style="{StaticResource BluePrimaryUiButton}" Click="SubmitDownload_Click"/>
						</StackPanel>
					</Grid>
				</StackPanel>
			</ui:Card>
		</Grid>
	</Grid>
</Page>
