<UserControl x:Class="Notion_Files_Management.Views.Controls.InlineColorPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Border BorderThickness="1"
            BorderBrush="{DynamicResource ControlFillColorDefaultBrush}"
            CornerRadius="8"
            Background="{DynamicResource ControlFillColorDefaultBrush}"
            Padding="12">
        <StackPanel>
            <!-- 颜色预览 -->
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <Border Grid.Column="0" 
                        CornerRadius="6,0,0,6"
                        BorderThickness="0"
                        Height="60">
                    <Border.Background>
                        <SolidColorBrush x:Name="ColorPreviewBrush"/>
                    </Border.Background>
                    <TextBlock x:Name="ColorHexText"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="White"
                               TextAlignment="Center"/>
                </Border>
                
                <Border Grid.Column="1" 
                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                        CornerRadius="0,6,6,0"
                        Padding="12,0"
                        Height="60">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="RGB" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4"/>
                        <TextBlock x:Name="RgbText" FontSize="12" FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 主颜色选择区域 -->
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="30"/>
                </Grid.ColumnDefinitions>

                <!-- 饱和度和亮度选择区域 - 使用LinearGradientBrush优化性能 -->
                <Border Grid.Column="0" 
                        BorderThickness="1"
                        BorderBrush="{DynamicResource ControlFillColorDefaultBrush}"
                        CornerRadius="6"
                        Background="White"
                        Height="200">
                    <Canvas x:Name="SaturationBrightnessCanvas"
                            MouseDown="OnSaturationBrightnessMouseDown"
                            MouseMove="OnSaturationBrightnessMouseMove"
                            MouseUp="OnSaturationBrightnessMouseUp"
                            ClipToBounds="True">
                        <!-- 使用LinearGradientBrush代替WriteableBitmap -->
                        <Rectangle x:Name="SaturationBrightnessGradient"
                                   Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Canvas}}"
                                   Height="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Canvas}}">
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop x:Name="GradientStopLeft" Color="White" Offset="0"/>
                                    <GradientStop x:Name="GradientStopRight" Color="Red" Offset="1"/>
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                        
                        <!-- 亮度渐变覆盖层 -->
                        <Rectangle Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Canvas}}"
                                   Height="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Canvas}}">
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="Transparent" Offset="0"/>
                                    <GradientStop Color="Black" Offset="1"/>
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                        
                        <!-- 选择指示器 -->
                        <Ellipse x:Name="ColorSelector"
                                 Width="14"
                                 Height="14"
                                 Stroke="White"
                                 StrokeThickness="2"
                                 Fill="Transparent"
                                 Canvas.Left="0"
                                 Canvas.Top="0"
                                 Visibility="Collapsed"/>
                    </Canvas>
                </Border>

                <!-- 色相滑块 - 使用LinearGradientBrush优化性能 -->
                <Border Grid.Column="2" 
                        Width="30"
                        BorderThickness="1"
                        BorderBrush="{DynamicResource ControlFillColorDefaultBrush}"
                        CornerRadius="6"
                        Background="White"
                        Height="200">
                    <Canvas x:Name="HueCanvas"
                            MouseDown="OnHueMouseDown"
                            MouseMove="OnHueMouseMove"
                            MouseUp="OnHueMouseUp"
                            ClipToBounds="True">
                        <!-- 色相渐变 - 使用LinearGradientBrush -->
                        <Rectangle Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Canvas}}"
                                   Height="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Canvas}}">
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#FF0000" Offset="0"/>
                                    <GradientStop Color="#FFFF00" Offset="0.167"/>
                                    <GradientStop Color="#00FF00" Offset="0.333"/>
                                    <GradientStop Color="#00FFFF" Offset="0.5"/>
                                    <GradientStop Color="#0000FF" Offset="0.667"/>
                                    <GradientStop Color="#FF00FF" Offset="0.833"/>
                                    <GradientStop Color="#FF0000" Offset="1"/>
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                        
                        <!-- 色相选择指示器 -->
                        <Rectangle x:Name="HueSelector"
                                   Width="30"
                                   Height="6"
                                   Stroke="White"
                                   StrokeThickness="2"
                                   Fill="Transparent"
                                   Canvas.Left="0"
                                   Canvas.Top="0"
                                   Visibility="Collapsed"/>
                    </Canvas>
                </Border>
            </Grid>

            <!-- RGB 输入 -->
            <StackPanel>
                <ui:TextBlock Text="RGB" Margin="0,0,0,8" Appearance="Tertiary" FontWeight="SemiBold"/>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="50"/>
                    </Grid.ColumnDefinitions>
                    
                    <ui:TextBlock Text="R:" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Width="20"/>
                    <Slider x:Name="RedSlider" Grid.Row="0" Grid.Column="2" 
                               Minimum="0" Maximum="255" ValueChanged="OnRgbSliderChanged"/>
                    <ui:TextBox x:Name="RedBox" Grid.Row="0" Grid.Column="4" 
                                TextChanged="OnRgbValueChanged"/>
                    
                    <ui:TextBlock Text="G:" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Width="20"/>
                    <Slider x:Name="GreenSlider" Grid.Row="1" Grid.Column="2" 
                               Minimum="0" Maximum="255" ValueChanged="OnRgbSliderChanged"/>
                    <ui:TextBox x:Name="GreenBox" Grid.Row="1" Grid.Column="4" 
                                TextChanged="OnRgbValueChanged"/>
                    
                    <ui:TextBlock Text="B:" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Width="20"/>
                    <Slider x:Name="BlueSlider" Grid.Row="2" Grid.Column="2" 
                               Minimum="0" Maximum="255" ValueChanged="OnRgbSliderChanged"/>
                    <ui:TextBox x:Name="BlueBox" Grid.Row="2" Grid.Column="4" 
                                TextChanged="OnRgbValueChanged"/>
                </Grid>
            </StackPanel>

            <!-- 预设颜色 -->
            <StackPanel Margin="0,12,0,0">
                <ui:TextBlock Text="预设颜色" Margin="0,0,0,8" Appearance="Tertiary" FontWeight="SemiBold"/>
                <UniformGrid Columns="12" Rows="2" Height="60">
                    <Border Background="#1E90FF" MouseDown="OnPresetColorClick" Tag="#1E90FF" Cursor="Hand" Margin="1" BorderThickness="1" BorderBrush="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="4"/>
                    <Border Background="#FF6B6B" MouseDown="OnPresetColorClick" Tag="#FF6B6B" Cursor="Hand" Margin="1" BorderThickness="1" BorderBrush="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="4"/>
                    <Border Background="#4ECDC4" MouseDown="OnPresetColorClick" Tag="#4ECDC4" Cursor="Hand" Margin="1" BorderThickness="1" BorderBrush="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="4"/>
                    <Border Background="#45B7D1" MouseDown="OnPresetColorClick" Tag="#45B7D1" Cursor="Hand" Margin="1" BorderThickness="1" BorderBrush="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="4"/>
                    <Border Background="#FFA07A" MouseDown="OnPresetColorClick" Tag="#FFA07A" Cursor="Hand" Margin="1" BorderThickness="1" BorderBrush="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="4"/>
                    <Border Background="#98D8C8" MouseDown="OnPresetColorClick" Tag="#98D8C8" Cursor="Hand" Margin="1" BorderThickness="1" BorderBrush="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="4"/>
                    <Border Background="#F7DC6F" MouseDown="OnPresetColorClick" Tag="#F7DC6F" Cursor="Hand" Margin="1" BorderThickness="1" BorderBrush="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="4"/>
                    <Border Background="#BB8FCE" MouseDown="OnPresetColorClick" Tag="#BB8FCE" Cursor="Hand" Margin="1" BorderThickness="1" BorderBrush="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="4"/>
                    <Border Background="#85C1E2" MouseDown="OnPresetColorClick" Tag="#85C1E2" Cursor="Hand" Margin="1" BorderThickness="1" BorderBrush="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="4"/>
                    <Border Background="#F1948A" MouseDown="OnPresetColorClick" Tag="#F1948A" Cursor="Hand" Margin="1" BorderThickness="1" BorderBrush="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="4"/>
                    <Border Background="#52BE80" MouseDown="OnPresetColorClick" Tag="#52BE80" Cursor="Hand" Margin="1" BorderThickness="1" BorderBrush="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="4"/>
                    <Border Background="#F8C471" MouseDown="OnPresetColorClick" Tag="#F8C471" Cursor="Hand" Margin="1" BorderThickness="1" BorderBrush="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="4"/>
                    <Border Background="#A569BD" MouseDown="OnPresetColorClick" Tag="#A569BD" Cursor="Hand" Margin="1" BorderThickness="1" BorderBrush="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="4"/>
                    <Border Background="#5DADE2" MouseDown="OnPresetColorClick" Tag="#5DADE2" Cursor="Hand" Margin="1" BorderThickness="1" BorderBrush="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="4"/>
                    <Border Background="#EC7063" MouseDown="OnPresetColorClick" Tag="#EC7063" Cursor="Hand" Margin="1" BorderThickness="1" BorderBrush="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="4"/>
                    <Border Background="#58D68D" MouseDown="OnPresetColorClick" Tag="#58D68D" Cursor="Hand" Margin="1" BorderThickness="1" BorderBrush="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="4"/>
                    <Border Background="#F4D03F" MouseDown="OnPresetColorClick" Tag="#F4D03F" Cursor="Hand" Margin="1" BorderThickness="1" BorderBrush="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="4"/>
                    <Border Background="#AF7AC5" MouseDown="OnPresetColorClick" Tag="#AF7AC5" Cursor="Hand" Margin="1" BorderThickness="1" BorderBrush="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="4"/>
                    <Border Background="#3498DB" MouseDown="OnPresetColorClick" Tag="#3498DB" Cursor="Hand" Margin="1" BorderThickness="1" BorderBrush="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="4"/>
                    <Border Background="#E74C3C" MouseDown="OnPresetColorClick" Tag="#E74C3C" Cursor="Hand" Margin="1" BorderThickness="1" BorderBrush="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="4"/>
                    <Border Background="#2ECC71" MouseDown="OnPresetColorClick" Tag="#2ECC71" Cursor="Hand" Margin="1" BorderThickness="1" BorderBrush="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="4"/>
                    <Border Background="#F39C12" MouseDown="OnPresetColorClick" Tag="#F39C12" Cursor="Hand" Margin="1" BorderThickness="1" BorderBrush="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="4"/>
                    <Border Background="#9B59B6" MouseDown="OnPresetColorClick" Tag="#9B59B6" Cursor="Hand" Margin="1" BorderThickness="1" BorderBrush="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="4"/>
                    <Border Background="#2980B9" MouseDown="OnPresetColorClick" Tag="#2980B9" Cursor="Hand" Margin="1" BorderThickness="1" BorderBrush="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="4"/>
                </UniformGrid>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
