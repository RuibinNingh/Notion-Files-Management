<Page x:Class="Notion_Files_Management.Views.NoticePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:mdxam="clr-namespace:MdXaml;assembly=MdXaml"
      xmlns:utils="clr-namespace:Notion_Files_Management.Utils"
      xmlns:models="clr-namespace:Notion_Files_Management.Models"
      Title="公告">

    <Page.Resources>
        <utils:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <utils:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis"/>
        <utils:TagToBackgroundConverter x:Key="TagToBg"/>
        <utils:TagToForegroundConverter x:Key="TagToFg"/>

        <!-- MdXaml 深色主题样式 -->
        <Style x:Key="DarkMdStyle" TargetType="{x:Type mdxam:MarkdownScrollViewer}">
            <Setter Property="MarkdownStyleName" Value="SasabuneStandard"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
        </Style>
    </Page.Resources>

    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ═══ 标题栏 ═══ -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <ui:SymbolIcon Symbol="Megaphone24"
                               FontSize="24"
                               Foreground="{DynamicResource SystemAccentColorLight2Brush}"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"/>
                <ui:TextBlock Text="公告中心"
                              FontTypography="Title"
                              VerticalAlignment="Center"
                              Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
            </StackPanel>

            <ui:Button Grid.Column="2"
                       x:Name="BtnRefresh"
                       Appearance="Secondary"
                       Content="刷新"
                       Icon="{ui:SymbolIcon ArrowSync24}"
                       VerticalAlignment="Center"
                       Click="OnRefreshClick"/>
        </Grid>

        <!-- ═══ 加载中状态 ═══ -->
        <StackPanel x:Name="LoadingPanel"
                    Grid.Row="1"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Visibility="Visible">
            <ui:ProgressRing IsIndeterminate="True"
                             Width="40" Height="40"
                             HorizontalAlignment="Center"/>
            <TextBlock Text="正在加载公告..."
                       FontSize="14"
                       HorizontalAlignment="Center"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Margin="0,12,0,0"/>
        </StackPanel>

        <!-- ═══ 错误/空状态 ═══ -->
        <StackPanel x:Name="EmptyPanel"
                    Grid.Row="1"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Visibility="Collapsed">
            <ui:SymbolIcon Symbol="DocumentDismiss24"
                           FontSize="48"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           HorizontalAlignment="Center"/>
            <TextBlock x:Name="TxtEmptyMessage"
                       Text="暂无公告"
                       FontSize="14"
                       HorizontalAlignment="Center"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Margin="0,12,0,0"/>
        </StackPanel>

        <!-- ═══ 公告卡片列表 ═══ -->
        <ItemsControl x:Name="NoticeList"
                      Grid.Row="1"
                      Visibility="Collapsed">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type models:NoticeItem}">
                    <Border CornerRadius="8"
                            Margin="0,0,0,12"
                            Padding="18,14,18,14"
                            Background="{DynamicResource ControlFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="1">

                        <StackPanel>
                            <!-- ── 卡片头部：标题 + 标签 + 日期 ── -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- 置顶图标 + 标题 + 标签 -->
                                <StackPanel Grid.Column="0"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center">

                                    <!-- 置顶图标 -->
                                    <ui:SymbolIcon Symbol="Pin24"
                                                   FontSize="16"
                                                   Foreground="{DynamicResource SystemAccentColorLight2Brush}"
                                                   Margin="0,0,6,0"
                                                   Visibility="{Binding Pinned, Converter={StaticResource BoolToVis}}"/>

                                    <!-- 标题 -->
                                    <TextBlock Text="{Binding Title}"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>

                                    <!-- 标签列表 -->
                                    <ItemsControl ItemsSource="{Binding Tags}" Margin="8,0,0,0">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border CornerRadius="4"
                                                        Padding="8,2,8,2"
                                                        Margin="4,0,0,0"
                                                        Background="{Binding Converter={StaticResource TagToBg}}">
                                                    <TextBlock Text="{Binding}"
                                                               FontSize="11"
                                                               FontWeight="Medium"
                                                               Foreground="{Binding Converter={StaticResource TagToFg}}"/>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <!-- 日期 -->
                                <TextBlock Grid.Column="2"
                                           Text="{Binding Date}"
                                           FontSize="12"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                            </Grid>

                            <!-- ── 分隔线 ── -->
                            <Separator Margin="0,10,0,8"
                                       Background="{DynamicResource ControlStrokeColorDefaultBrush}"/>

                            <!-- ── Markdown 正文（MdXaml 渲染） ── -->
                            <mdxam:MarkdownScrollViewer
                                Style="{StaticResource DarkMdStyle}"
                                Markdown="{Binding Content}"
                                Visibility="{Binding IsLoading, Converter={StaticResource InverseBoolToVis}}"/>

                            <!-- ── 加载中占位 ── -->
                            <ui:ProgressRing IsIndeterminate="True"
                                             Width="24" Height="24"
                                             HorizontalAlignment="Center"
                                             Margin="0,8,0,8"
                                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</Page>
