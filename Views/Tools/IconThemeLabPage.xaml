<Page x:Class="Notion_Files_Management.Views.Tools.IconThemeLabPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="IconThemeLab">

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <StackPanel Grid.Row="0"
                    Orientation="Horizontal"
                    Margin="0,0,0,16">
            <ui:SymbolIcon Symbol="Color24" FontSize="28" Margin="0,0,10,0" />
            <ui:TextBlock Text="图标着色实验室"
                          FontTypography="Title"
                          VerticalAlignment="Center"
                          Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
        </StackPanel>

        <!-- 说明 -->
        <StackPanel Grid.Row="1" Margin="0,0,0,16">
            <ui:TextBlock Text="对比三种按钮图标写法在当前主题下的实际前景色表现。"
                          Appearance="Tertiary"
                          Margin="0,0,0,4"/>
            <ui:TextBlock Text="1）Button.Icon 推荐写法   2）Button.Icon 子元素写法   3）Content 内联 StackPanel 写法"
                          Appearance="Tertiary"
                          FontSize="12"/>
        </StackPanel>

        <!-- 主体 -->
        <ui:Card Grid.Row="2" Padding="20">
            <StackPanel>
                <!-- 三个按钮对比 -->
                <StackPanel Margin="0,0,0,16">
                    <ui:TextBlock Text="按钮对比"
                                  FontTypography="Subtitle"
                                  Margin="0,0,0,8"/>

                    <!-- 垂直堆叠三种写法（用子元素 Margin 控制间距，避免 Spacing） -->
                    <StackPanel Orientation="Vertical">
                        <!-- 0) Primary 无 Style（基准：一定是 WpfUI 模板） -->
                        <ui:Button x:Name="BtnPrimaryNoStyle"
                                   Appearance="Primary"
                                   Content="Primary（无Style基准）"
                                   Icon="{ui:SymbolIcon Symbol=FolderOpen24}"
                                   Margin="0,0,0,6"/>

                        <!-- 1) Primary 使用 BluePrimaryUiButton（验证：是否仍然圆角蓝底） -->
                        <ui:Button x:Name="BtnPrimaryWithStyle"
                                   Style="{StaticResource BluePrimaryUiButton}"
                                   Content="Primary（BluePrimaryUiButton）"
                                   Icon="{ui:SymbolIcon Symbol=FolderOpen24}"
                                   Margin="0,0,0,6"/>

                        <!-- 2) 原生 WPF Button（对照：灰方框就是它） -->
                        <Button x:Name="BtnNativeWpf"
                                Content="原生 Button（灰方框对照）"
                                Margin="0,0,0,10"/>

                        <!-- 1. Icon 属性写法 -->
                        <ui:Button x:Name="BtnIconProperty"
                                   Style="{StaticResource BluePrimaryUiButton}"
                                   Content="Icon 属性写法"
                                   Icon="{ui:SymbolIcon Symbol=FolderOpen24}"
                                   Margin="0,0,0,4" />

                        <!-- 2. Button.Icon 子元素写法 -->
                        <ui:Button x:Name="BtnIconElement"
                                   Style="{StaticResource BluePrimaryUiButton}"
                                   Margin="0,0,0,4">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="FolderOpen24"
                                               Style="{StaticResource ButtonInlineIconStyle}" />
                            </ui:Button.Icon>
                            <TextBlock Text="Button.Icon 子元素写法"/>
                        </ui:Button>

                        <!-- 3. Content 内联 StackPanel 写法 -->
                        <ui:Button x:Name="BtnInlineContent"
                                   Style="{StaticResource BluePrimaryUiButton}"
                                   Margin="0,0,0,4">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="FolderOpen24"
                                               Style="{StaticResource ButtonInlineIconStyle}"
                                               Margin="0,0,8,0"/>
                                <TextBlock Text="Content 内联 StackPanel 写法"/>
                            </StackPanel>
                        </ui:Button>
                    </StackPanel>
                </StackPanel>

                <!-- 主题信息 & 关键刷子值 -->
                <Separator Margin="0,4,0,8"/>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center"
                            Margin="0,0,0,8">
                    <ui:TextBlock Text="当前主题：" Appearance="Tertiary"/>
                    <ui:TextBlock x:Name="TxtCurrentTheme"
                                  Margin="4,0,16,0"/>

                    <ui:Button x:Name="BtnToggleTheme"
                               Content="切换主题（浅/深）"
                               Appearance="Secondary"
                               Click="BtnToggleTheme_Click"/>
                </StackPanel>

                <StackPanel>
                    <ui:TextBlock Text="关键刷子颜色："
                                  FontTypography="Subtitle"
                                  Margin="0,0,0,6"/>
                    <ui:TextBlock x:Name="TxtBrushTextPrimary"
                                  Margin="0,0,0,2"
                                  Appearance="Tertiary"/>
                    <ui:TextBlock x:Name="TxtBrushTextOnAccent"
                                  Margin="0,0,0,2"
                                  Appearance="Tertiary"/>
                </StackPanel>
            </StackPanel>
        </ui:Card>
    </Grid>
</Page>

