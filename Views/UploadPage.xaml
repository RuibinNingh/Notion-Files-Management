<Page x:Class="Notion_Files_Management.Views.UploadPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="上传">

	<Grid>
		<!-- 主页面 -->
		<Grid Margin="30">
			<StackPanel>
				<StackPanel HorizontalAlignment="Left" Orientation="Horizontal" Margin="0,0,0,20">
					<ui:SymbolIcon Symbol="ArrowUpload24" FontSize="32" Margin="0,0,15,0"/>
					<ui:TextBlock Text="文件上传 Upload"
                                  FontTypography="Title"
                                  VerticalAlignment="Center"
                                  Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
				</StackPanel>

				<ui:Card Padding="20">
					<StackPanel>
						<ui:Button x:Name="BtnOpenUploadDialog"
                                   Content="上传新文件"
                                   Icon="{ui:SymbolIcon Symbol=Add24}"
                                   Appearance="Primary"
                                   Click="BtnOpenUploadDialog_Click"/>

						<ui:TextBlock Text="活动上传任务"
                                      Appearance="Tertiary"
                                      Margin="0,20,0,8"/>
						<ui:TextBlock Text="提示：对于每个上传任务，每上传一个分片（15MB）才会更新一次上传进度"
              Appearance="Tertiary"
              Margin="0,20,0,8"/>

						<Border BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8">

							<ListView x:Name="UploadTaskListView"
                                      ItemsSource="{Binding DisplayUploads}"
                                      MinHeight="200"
                                      MaxHeight="450"
                                      Background="Transparent"
                                      Foreground="{DynamicResource TextFillColorPrimaryBrush}">
								<ListView.ItemTemplate>
									<DataTemplate>
										<Grid Margin="0,8">
											<Grid.ColumnDefinitions>
												<ColumnDefinition Width="260"/>
												<ColumnDefinition Width="*"/>
												<ColumnDefinition Width="170"/>
											</Grid.ColumnDefinitions>

											<!-- 左：文件名/状态 -->
											<StackPanel VerticalAlignment="Center">
												<ui:TextBlock Text="{Binding FileName}"
                                                              FontWeight="SemiBold"
                                                              TextTrimming="CharacterEllipsis"/>
												<ui:TextBlock Text="{Binding StatusText}"
                                                              FontSize="11"
                                                              Appearance="Tertiary"/>
											</StackPanel>

											<!-- 中：进度条 + 已上传/总量 -->
											<StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="20,0">
												<ProgressBar Value="{Binding Progress}" Maximum="100" Height="4" Margin="0,0,0,5"/>

												<Grid>
													<Grid.ColumnDefinitions>
														<ColumnDefinition Width="Auto"/>
														<ColumnDefinition Width="Auto"/>
													</Grid.ColumnDefinitions>

													<ui:TextBlock Grid.Column="0"
                                                                  Text="{Binding UploadedMB, StringFormat={}{0:0.0} MB}"
                                                                  FontSize="10"
                                                                  Appearance="Tertiary"/>

													<ui:TextBlock Grid.Column="1"
                                                                  Text="{Binding TotalMB, StringFormat={}/ {0:0.0} MB}"
                                                                  Margin="6,0,0,0"
                                                                  FontSize="10"
                                                                  Appearance="Tertiary"/>
												</Grid>
											</StackPanel>

											<!-- 右：百分比/速度/ETA（速度显示 EMA 平滑值） -->
											<StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
												<ui:TextBlock Text="{Binding Progress, StringFormat={}{0:0}%}"
                                                              HorizontalAlignment="Right"
                                                              FontSize="12"
                                                              FontWeight="SemiBold"
                                                              Foreground="{DynamicResource SystemAccentColorBrush}"/>

												<ui:TextBlock Text="{Binding SmoothedSpeedMBps, StringFormat={}{0:0.0} MB/s}"
                                                              HorizontalAlignment="Right"
                                                              Foreground="{DynamicResource SystemAccentColorBrush}"/>

												<ui:TextBlock Text="{Binding ETASeconds, StringFormat=剩余时间: {0}s}"
                                                              FontSize="11"
                                                              Appearance="Tertiary"
                                                              HorizontalAlignment="Right"/>
											</StackPanel>
										</Grid>
									</DataTemplate>
								</ListView.ItemTemplate>
							</ListView>

						</Border>
					</StackPanel>
				</ui:Card>
			</StackPanel>
		</Grid>

		<!-- 模态遮罩 -->
		<Grid x:Name="ModalOverlay" Background="#99000000" Visibility="Collapsed">

			<!-- 模态窗口1 -->
			<ui:Card x:Name="ModalStep1" Background="#ff222329" Width="700" VerticalAlignment="Center" Visibility="Collapsed">
				<StackPanel Margin="14">

					<ui:TextBlock Text="上传 Notion 文件"
                                  FontTypography="Subtitle"
                                  Margin="0,0,0,12"/>

					<!-- 选择文件 + 单/多选 -->
					<Grid Margin="0,0,0,12">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*"/>
							<ColumnDefinition Width="Auto"/>
						</Grid.ColumnDefinitions>

						<ui:TextBlock Text="选择文件"
                                      Appearance="Tertiary"
                                      VerticalAlignment="Center"/>

						<StackPanel Grid.Column="1" Orientation="Horizontal">
							<ui:ToggleSwitch x:Name="ToggleMultiSelect"
                                             Content="多选"
                                             IsChecked="True"
                                             Margin="0,0,12,0"
                                             VerticalAlignment="Center"/>

							<ui:Button Content="选择文件"
                                       Appearance="Primary"
                                       Margin="0,0,8,0"
                                       Click="SelectUploadFiles_Click"/>

							<ui:Button Content="清空"
                                       Click="ClearUploadFiles_Click"/>
						</StackPanel>
					</Grid>

					<!-- 文件路径列表（滚动） -->
					<Border BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="6"
                            Margin="0,0,0,14">
						<ListView x:Name="UploadFileListView"
                                  ItemsSource="{Binding SelectedUploadFiles}"
                                  MaxHeight="220"
                                  Background="Transparent"
                                  Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto">
							<ListView.ItemTemplate>
								<DataTemplate>
									<ui:TextBlock Text="{Binding}"
                                                  TextTrimming="CharacterEllipsis"
                                                  Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                  Margin="4,3"/>
								</DataTemplate>
							</ListView.ItemTemplate>
						</ListView>
					</Border>

					<!-- 并发已移动到设置页 -->
					<ui:TextBlock Text="上传并发数由【设置】页统一管理"
								  Appearance="Tertiary"
								  FontSize="12"
								  Margin="0,0,0,14"/>

					<!-- PageId -->
					<ui:TextBlock Text="Notion Page ID"
                                  Appearance="Tertiary"
                                  Margin="0,0,0,6"/>

					<ui:TextBox x:Name="PageIdInput"
                                PlaceholderText="粘贴 Page ID（如: 18b4e...）"
                                Margin="0,0,0,14"/>

					<!-- 底部 -->
					<Grid>
						<ui:TextBlock x:Name="ModalHint"
                                      Text=""
                                      Appearance="Tertiary"
                                      VerticalAlignment="Center"/>

						<StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
							<ui:Button Content="取消"
                                       Margin="0,0,8,0"
                                       Click="CloseModal_Click"/>

							<ui:Button x:Name="BtnConfirmStart"
                                       Content="确认并开始上传"
                                       Appearance="Primary"
                                       Click="ConfirmStart_Click"/>
						</StackPanel>
					</Grid>

				</StackPanel>
			</ui:Card>
		</Grid>
	</Grid>
</Page>
