<Page x:Class="Notion_Files_Management.Views.UploadPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="上传">

	<Page.Resources>
		<SolidColorBrush x:Key="StatusCompletedBrush" Color="#4CAF50"/>
		<SolidColorBrush x:Key="StatusErrorBrush"     Color="#EF5350"/>
		<SolidColorBrush x:Key="StatusWaitingBrush"    Color="#78909C"/>
	</Page.Resources>

	<Grid>
		<!-- 主页面 -->
		<Grid Margin="30">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="*"/>
			</Grid.RowDefinitions>

			<StackPanel Grid.Row="0" HorizontalAlignment="Left" Orientation="Horizontal" Margin="0,0,0,20">
				<ui:SymbolIcon Symbol="ArrowUpload24" FontSize="32" Margin="0,0,15,0"/>
				<ui:TextBlock Text="文件上传 Upload"
                                  FontTypography="Title"
                                  VerticalAlignment="Center"
                                  Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
			</StackPanel>

			<ui:Card Grid.Row="1" Padding="20"
					 VerticalAlignment="Stretch" VerticalContentAlignment="Stretch">
				<Grid>
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="*"/>
					</Grid.RowDefinitions>

					<ui:Button x:Name="BtnOpenUploadDialog"
							   Grid.Row="0"
							   Style="{StaticResource BluePrimaryUiButton}"
							   Content="上传新文件"
							   Icon="{ui:SymbolIcon Symbol=Add24}"
							   Click="BtnOpenUploadDialog_Click" />

					<ui:TextBlock Grid.Row="1"
                                      Text="活动上传任务"
                                      Appearance="Tertiary"
                                      Margin="0,20,0,8"/>

					<Border Grid.Row="2"
							VerticalAlignment="Stretch"
                                BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8">

						<ListView x:Name="UploadTaskListView"
                                      ItemsSource="{Binding DisplayUploads}"
                                      MinHeight="200"
                                      Background="Transparent"
                                      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                      HorizontalContentAlignment="Stretch"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
								<ListView.ItemContainerStyle>
									<Style TargetType="ListViewItem">
										<Setter Property="HorizontalContentAlignment" Value="Stretch"/>
										<Setter Property="Padding" Value="0"/>
										<Setter Property="Margin" Value="0"/>
									</Style>
								</ListView.ItemContainerStyle>
								<ListView.ItemTemplate>
									<DataTemplate>
										<Border CornerRadius="8"
										        Padding="14,10"
										        Margin="4,3"
										        Background="{DynamicResource ControlFillColorDefaultBrush}">
											<StackPanel>
												<!-- 第一行: 状态图标 + 文件名（左）  百分比 + 速度（右） -->
												<Grid Margin="0,0,0,8">
													<Grid.ColumnDefinitions>
														<ColumnDefinition Width="*"/>
														<ColumnDefinition Width="Auto"/>
													</Grid.ColumnDefinitions>

													<StackPanel Orientation="Horizontal"
													            VerticalAlignment="Center"
													            Grid.Column="0">
														<ui:SymbolIcon FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center">
															<ui:SymbolIcon.Style>
																<Style TargetType="ui:SymbolIcon">
																	<Setter Property="Symbol" Value="ArrowUpload24"/>
																	<Setter Property="Foreground" Value="{DynamicResource SystemAccentColorBrush}"/>
																	<Style.Triggers>
																		<DataTrigger Binding="{Binding Status}" Value="completed">
																			<Setter Property="Symbol" Value="CheckmarkCircle24"/>
																			<Setter Property="Foreground" Value="{StaticResource StatusCompletedBrush}"/>
																		</DataTrigger>
																		<DataTrigger Binding="{Binding Status}" Value="error">
																			<Setter Property="Symbol" Value="DismissCircle24"/>
																			<Setter Property="Foreground" Value="{StaticResource StatusErrorBrush}"/>
																		</DataTrigger>
																		<DataTrigger Binding="{Binding Status}" Value="waiting">
																			<Setter Property="Symbol" Value="Clock24"/>
																			<Setter Property="Foreground" Value="{StaticResource StatusWaitingBrush}"/>
																		</DataTrigger>
																	</Style.Triggers>
																</Style>
															</ui:SymbolIcon.Style>
														</ui:SymbolIcon>

														<TextBlock Text="{Binding FileName}"
														           FontWeight="SemiBold"
														           FontSize="13"
														           TextTrimming="CharacterEllipsis"
														           VerticalAlignment="Center"/>
													</StackPanel>

													<StackPanel Orientation="Horizontal"
													            Grid.Column="1"
													            VerticalAlignment="Center">
														<TextBlock Text="{Binding Progress, StringFormat={}{0:0}%}"
														           FontSize="14"
														           FontWeight="Bold"
														           Margin="12,0,12,0"
														           VerticalAlignment="Center">
															<TextBlock.Style>
																<Style TargetType="TextBlock">
																	<Setter Property="Foreground" Value="{DynamicResource SystemAccentColorBrush}"/>
																	<Style.Triggers>
																		<DataTrigger Binding="{Binding Status}" Value="completed">
																			<Setter Property="Foreground" Value="{StaticResource StatusCompletedBrush}"/>
																		</DataTrigger>
																		<DataTrigger Binding="{Binding Status}" Value="error">
																			<Setter Property="Foreground" Value="{StaticResource StatusErrorBrush}"/>
																		</DataTrigger>
																	</Style.Triggers>
																</Style>
															</TextBlock.Style>
														</TextBlock>

														<TextBlock Text="{Binding SmoothedSpeedMBps, StringFormat={}{0:0.0} MB/s}"
														           FontSize="12"
														           VerticalAlignment="Center"
														           Foreground="{DynamicResource SystemAccentColorBrush}"/>
													</StackPanel>
												</Grid>

												<!-- 第二行: 全宽进度条 -->
												<ProgressBar Value="{Binding Progress}"
												             Maximum="100"
												             Height="8"
												             Margin="0,0,0,6"
												             HorizontalAlignment="Stretch">
													<ProgressBar.Style>
														<Style TargetType="ProgressBar">
															<Setter Property="Foreground" Value="{DynamicResource SystemAccentColorBrush}"/>
															<Style.Triggers>
																<DataTrigger Binding="{Binding Status}" Value="completed">
																	<Setter Property="Foreground" Value="{StaticResource StatusCompletedBrush}"/>
																</DataTrigger>
																<DataTrigger Binding="{Binding Status}" Value="error">
																	<Setter Property="Foreground" Value="{StaticResource StatusErrorBrush}"/>
																</DataTrigger>
																<DataTrigger Binding="{Binding Status}" Value="waiting">
																	<Setter Property="Foreground" Value="{StaticResource StatusWaitingBrush}"/>
																</DataTrigger>
															</Style.Triggers>
														</Style>
													</ProgressBar.Style>
												</ProgressBar>

												<!-- 第三行: 大小详情（左）+ 剩余时间（右） -->
												<Grid>
													<Grid.ColumnDefinitions>
														<ColumnDefinition Width="*"/>
														<ColumnDefinition Width="Auto"/>
													</Grid.ColumnDefinitions>

													<StackPanel Orientation="Horizontal" Grid.Column="0">
														<TextBlock Text="{Binding UploadedMB, StringFormat={}{0:0.0} MB}"
														           FontSize="11"
														           Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
														<TextBlock Text="{Binding TotalMB, StringFormat={} / {0:0.0} MB}"
														           FontSize="11"
														           Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
														<TextBlock Text="{Binding StatusText, StringFormat={} · {0}}"
														           FontSize="11"
														           Margin="4,0,0,0"
														           Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
													</StackPanel>

													<TextBlock Grid.Column="1"
													           Text="{Binding ETASeconds, StringFormat=剩余 {0}s}"
													           FontSize="11"
													           Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
												</Grid>
											</StackPanel>
										</Border>
									</DataTemplate>
								</ListView.ItemTemplate>
							</ListView>

						</Border>
				</Grid>
			</ui:Card>
		</Grid>

		<!-- ========== 模态遮罩（保持不变） ========== -->
		<Grid x:Name="ModalOverlay" Background="#99000000" Visibility="Collapsed">

			<ui:Card x:Name="ModalStep1" Background="#ff222329" Width="700" VerticalAlignment="Center" Visibility="Collapsed">
				<StackPanel Margin="14">

					<ui:TextBlock Text="上传 Notion 文件"
                                  FontTypography="Subtitle"
                                  Margin="0,0,0,12"/>

					<Grid Margin="0,0,0,12">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*"/>
							<ColumnDefinition Width="Auto"/>
						</Grid.ColumnDefinitions>

						<ui:TextBlock Text="选择文件 / 文件夹"
                                      Appearance="Tertiary"
                                      VerticalAlignment="Center"/>

						<StackPanel Grid.Column="1" Orientation="Horizontal">
							<ui:ToggleSwitch x:Name="ToggleMultiSelect"
                                             Content="多选"
                                             IsChecked="True"
                                             Margin="0,0,12,0"
                                             VerticalAlignment="Center"/>

							<ui:Button Content="选择文件"
                                       Style="{StaticResource BluePrimaryUiButton}"
                                       Margin="0,0,8,0"
                                       Click="SelectUploadFiles_Click"/>

							<ui:Button Content="选择文件夹"
                                       Margin="0,0,8,0"
                                       Click="SelectUploadFolder_Click"/>

							<ui:Button Content="清空"
                                       Click="ClearUploadFiles_Click"/>
						</StackPanel>
					</Grid>

					<Border BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="6"
                            Margin="0,0,0,14">
						<ListView x:Name="UploadFileListView"
                                  ItemsSource="{Binding SelectedUploadFiles}"
                                  MaxHeight="220"
                                  Background="Transparent"
                                  Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto">
							<ListView.ItemTemplate>
								<DataTemplate>
									<ui:TextBlock Text="{Binding}"
                                                  TextTrimming="CharacterEllipsis"
                                                  Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                  Margin="4,3"/>
								</DataTemplate>
							</ListView.ItemTemplate>
						</ListView>
					</Border>

					<ui:TextBlock Text="上传并发数由【设置】页统一管理"
								  Appearance="Tertiary"
								  FontSize="12"
								  Margin="0,0,0,14"/>

					<ui:TextBlock Text="Notion Page ID"
                                  Appearance="Tertiary"
                                  Margin="0,0,0,6"/>

					<ui:TextBox x:Name="PageIdInput"
                                PlaceholderText="粘贴 Page ID（如: 18b4e...）"
							TextChanged="PageIdInput_TextChanged"
                                Margin="0,0,0,14"/>

					<ui:TextBlock x:Name="PageIdErrorText"
							 Text=""
							 FontSize="12"
							 Margin="0,0,0,14"
							 Foreground="#FFEF5350"/>

					<Grid>
						<ui:TextBlock x:Name="ModalHint"
                                      Text=""
                                      Appearance="Tertiary"
                                      VerticalAlignment="Center"/>

						<StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
							<ui:Button Content="取消"
                                       Margin="0,0,8,0"
                                       Click="CloseModal_Click"/>

							<ui:Button x:Name="BtnConfirmStart"
                                       Content="确认并开始上传"
                                       Style="{StaticResource BluePrimaryUiButton}"
                                       Click="ConfirmStart_Click"/>
						</StackPanel>
					</Grid>

				</StackPanel>
			</ui:Card>
		</Grid>
	</Grid>
</Page>
