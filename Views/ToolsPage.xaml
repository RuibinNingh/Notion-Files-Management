<Page x:Class="Notion_Files_Management.Views.ToolsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:utils="clr-namespace:Notion_Files_Management.Utils"
      Title="工具箱">

    <Page.Resources>
        <utils:ResponsiveClampConverter x:Key="ResponsiveClamp"/>
    </Page.Resources>

    <Grid>
        <Grid Margin="30" VerticalAlignment="Top">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 顶部标题 -->
            <StackPanel Grid.Row="0"
                        Orientation="Horizontal"
                        HorizontalAlignment="Left"
                        Margin="0,0,0,12">
                <ui:SymbolIcon Symbol="Toolbox24" FontSize="32" Margin="0,0,15,0"/>
                <ui:TextBlock Text="工具箱"
                              Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                              FontTypography="Title"
                              VerticalAlignment="Center"/>
            </StackPanel>

            <!-- 主体 -->
            <ui:Card Grid.Row="1" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 简介 -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,14">
                        <ui:TextBlock Text="这里放一些辅助功能与诊断工具。"
                                      Appearance="Tertiary"/>
                    </StackPanel>

                    <!-- 工具列表 -->
                    <StackPanel Grid.Row="1">
                        <!-- Notion 相关 -->
                        <Border BorderThickness="1"
                                BorderBrush="#33000000"
                                CornerRadius="8"
                                Padding="12"
                                Margin="0,0,0,12">
                            <StackPanel>
                                <ui:TextBlock Text="Notion 相关"
                                              FontTypography="Subtitle"
                                              Margin="2,2,2,10"/>

                                <!-- Notion 页面大小自动更新/查询 (v1.4.0-Status) -->
                                <Border BorderThickness="1"
                                        BorderBrush="#22000000"
                                        CornerRadius="8"
                                        Padding="12"
                                        Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <ui:SymbolIcon Symbol="DocumentSearch24"
                                                       FontSize="22"
                                                       Margin="0,2,14,0"/>

                                        <StackPanel Grid.Column="1">
                                            <ui:TextBlock Text="Notion 页面大小自动更新/查询"
                                                          FontWeight="SemiBold"/>
                                            <ui:TextBlock Text="自动扫描数据源页面中的文件并累加大小写入属性，或查询单个页面的文件信息。"
                                                          Appearance="Tertiary"
                                                          TextWrapping="Wrap"
                                                          Margin="0,4,0,0"/>
                                        </StackPanel>

                                        <ui:Button Grid.Column="2"
                                                   Content="运行"
                                                   Style="{StaticResource BluePrimaryUiButton}"
                                                   MinWidth="96"
                                                   Click="OpenSizeUpdateChoice_Click"/>
                                    </Grid>
                                </Border>

                                <!-- 数据源迁移 (v1.3.0-Status+) -->
                                <Border BorderThickness="1"
                                        BorderBrush="#22000000"
                                        CornerRadius="8"
                                        Padding="12"
                                        Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <ui:SymbolIcon Symbol="ArrowSync24"
                                                       FontSize="22"
                                                       Margin="0,2,14,0"/>

                                        <StackPanel Grid.Column="1">
                                            <ui:TextBlock Text="数据源迁移"
                                                          FontWeight="SemiBold"/>
                                            <ui:TextBlock Text="将一个数据源的所有页面按属性映射批量复制到另一个数据源，保留页面内容。支持多线程并发。"
                                                          Appearance="Tertiary"
                                                          TextWrapping="Wrap"
                                                          Margin="0,4,0,0"/>
                                        </StackPanel>

                                        <ui:Button Grid.Column="2"
                                                   Content="开始迁移"
                                                   Style="{StaticResource BluePrimaryUiButton}"
                                                   MinWidth="96"
                                                   Click="OpenMigrateModal_Click"/>
                                    </Grid>
                                </Border>

                                <!-- 批量去除后缀 (v1.3.0-Status+) -->
                                <Border BorderThickness="1"
                                        BorderBrush="#22000000"
                                        CornerRadius="8"
                                        Padding="12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <ui:SymbolIcon Symbol="Rename24"
                                                       FontSize="22"
                                                       Margin="0,2,14,0"/>

                                        <StackPanel Grid.Column="1">
                                            <ui:TextBlock Text="批量去除后缀"
                                                          FontWeight="SemiBold"/>
                                            <ui:TextBlock Text="批量去除数据库页面标题中的指定后缀（如 &quot;(1)&quot;），支持自定义后缀内容。"
                                                          Appearance="Tertiary"
                                                          TextWrapping="Wrap"
                                                          Margin="0,4,0,0"/>
                                        </StackPanel>

                                        <ui:Button Grid.Column="2"
                                                   Content="运行"
                                                   Style="{StaticResource BluePrimaryUiButton}"
                                                   MinWidth="96"
                                                   Click="OpenBatchSuffixModal_Click"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- 软件工具 -->
                        <Border BorderThickness="1"
                                BorderBrush="#33000000"
                                CornerRadius="8"
                                Padding="12">
                            <StackPanel>
                                <ui:TextBlock Text="软件工具"
                                              FontTypography="Subtitle"
                                              Margin="2,2,2,10"/>

                                <!-- 查看日志文件 -->
                                <Border BorderThickness="1"
                                        BorderBrush="#22000000"
                                        CornerRadius="8"
                                        Padding="12"
                                        Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <ui:SymbolIcon Symbol="Folder24"
                                                       FontSize="22"
                                                       Margin="0,2,14,0"/>

                                        <StackPanel Grid.Column="1">
                                            <ui:TextBlock Text="查看日志文件"
                                                          FontWeight="SemiBold"/>
                                            <ui:TextBlock Text="打开应用程序的日志文件夹，查看运行日志和错误记录。"
                                                          Appearance="Tertiary"
                                                          TextWrapping="Wrap"
                                                          Margin="0,4,0,0"/>
                                        </StackPanel>

                                        <ui:Button Grid.Column="2"
                                                   Content="打开"
                                                   Appearance="Secondary"
                                                   MinWidth="96"
                                                   Click="OpenLogFolder_Click"/>
                                    </Grid>
                                </Border>

                                <!-- 报告错误 -->
                                <Border BorderThickness="1"
                                        BorderBrush="#22000000"
                                        CornerRadius="8"
                                        Padding="12"
                                        Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <ui:SymbolIcon Symbol="Bug24"
                                                       FontSize="22"
                                                       Margin="0,2,14,0"/>

                                        <StackPanel Grid.Column="1">
                                            <ui:TextBlock Text="报告错误"
                                                          FontWeight="SemiBold"/>
                                            <ui:TextBlock Text="遇到错误了?向我们报告,我们可能会解决它"
                                                          Appearance="Tertiary"
                                                          TextWrapping="Wrap"
                                                          Margin="0,4,0,0"/>
                                        </StackPanel>

                                        <ui:Button Grid.Column="2"
                                                   Content="报告"
                                                   Appearance="Secondary"
                                                   MinWidth="96"
                                                   Click="ReportError_Click"/>
                                    </Grid>
                                </Border>

                                <!-- 清除一切缓存 (v1.5.0-Status) -->
                                <Border BorderThickness="1"
                                        BorderBrush="#22000000"
                                        CornerRadius="8"
                                        Padding="12">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <ui:SymbolIcon Symbol="Delete24"
                                                           FontSize="22"
                                                           Margin="0,2,14,0"/>

                                            <StackPanel Grid.Column="1">
                                                <ui:TextBlock Text="清除一切缓存"
                                                              FontWeight="SemiBold"/>
                                                <ui:TextBlock Text="清除应用的所有缓存数据，包括配置文件、公告缓存、背景图片缓存和日志文件。"
                                                              Appearance="Tertiary"
                                                              TextWrapping="Wrap"
                                                              Margin="0,4,0,0"/>
                                            </StackPanel>

                                            <ui:Button x:Name="BtnClearAllCache" Grid.Column="2"
                                                       Content="清除"
                                                       Appearance="Danger"
                                                       MinWidth="96"
                                                       Click="ClearAllCache_Click"/>
                                        </Grid>

                                        <!-- 清除缓存确认提示（内嵌式） -->
                                        <ui:InfoBar x:Name="ClearCacheConfirmBar"
                                                    Title="⚠ 危险操作"
                                                    Message="此操作将清除所有缓存数据（配置、公告缓存、背景缓存、日志），可能导致不可逆的数据损失！确定继续？"
                                                    Severity="Error"
                                                    IsOpen="False"
                                                    IsClosable="True"
                                                    Margin="0,8,0,0"/>
                                        <StackPanel x:Name="ClearCacheConfirmButtons"
                                                    Orientation="Horizontal"
                                                    HorizontalAlignment="Right"
                                                    Visibility="Collapsed"
                                                    Margin="0,4,0,0">
                                            <ui:Button Content="确认清除"
                                                       Appearance="Danger"
                                                       Click="ConfirmClearAllCache_Click"
                                                       Margin="0,0,8,0"/>
                                            <ui:Button Content="取消"
                                                       Appearance="Secondary"
                                                       Click="CancelClearAllCache_Click"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </ui:Card>
        </Grid>

        <!-- ============ ModalOverlay（参考 DownloadPage） ============ -->
        <Grid x:Name="ModalOverlay" Background="#99000000" Visibility="Collapsed">

            <!-- ===== PageInfo Step1：输入 Page ID ===== -->
            <ui:Card x:Name="ModalStep1" Background="#ff222329" Width="460" VerticalAlignment="Center" Visibility="Collapsed">
                <StackPanel Margin="10">
                    <ui:TextBlock Text="获取 Notion 页面信息" FontTypography="Subtitle" Margin="0,0,0,15"/>
                    <ui:TextBlock Text="请输入目标页面 ID" Appearance="Tertiary" Margin="0,0,0,8"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <ui:TextBox x:Name="PageIdInput" PlaceholderText="粘贴 Notion 页面 ID" TextChanged="PageIdInput_TextChanged"/>
                        <ui:Button x:Name="BtnStartQuery"
                                   Grid.Column="1"
                                   Content="开始获取"
                                   Style="{StaticResource BluePrimaryUiButton}"
                                   Margin="10,0,0,0"
                                   Click="StartQuery_Click"/>
                    </Grid>

                    <ui:TextBlock x:Name="PageIdErrorText"
                                 Text=""
                                 FontSize="12"
                                 Margin="0,6,0,0"
                                 Foreground="#FFEF5350"/>

                    <!-- 探测线程数 -->
                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0" VerticalAlignment="Center">
                        <ui:TextBlock Text="探测线程数：" VerticalAlignment="Center"/>
                        <ui:TextBox x:Name="ProbeWorkersInput" Text="8" Width="60" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        <ui:TextBlock Text="（建议 4–16）" Appearance="Tertiary" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>

                    <ui:Button Content="取消" HorizontalAlignment="Right" Margin="0,20,0,0" Click="CloseModal_Click"/>
                </StackPanel>
            </ui:Card>

            <!-- ===== PageInfo Step2：进度 + 结果列表 ===== -->
            <ui:Card x:Name="ModalStep2" Background="#ff222329" Width="760" VerticalAlignment="Center" Visibility="Collapsed">
                <StackPanel Margin="10">

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <ui:TextBlock x:Name="ProbeTitle" Text="正在扫描页面文件" FontTypography="Subtitle" Margin="0,0,0,6"/>
                            <ui:TextBlock x:Name="ProbeStatusText" Text="准备开始…" Appearance="Tertiary"/>
                            <ui:TextBlock x:Name="ProbeElapsedText" Text="" Appearance="Tertiary" FontSize="12" Margin="0,2,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                            <ui:Button x:Name="BtnCancelQuery" Content="取消" Appearance="Danger" Margin="0,0,8,0" Click="CancelQuery_Click"/>
                            <ui:Button Content="关闭" Click="CloseModal_Click"/>
                        </StackPanel>
                    </Grid>

                    <!-- 进度条（下载页同款高度） -->
                    <ProgressBar x:Name="ProbeProgressBar"
                                 Minimum="0" Maximum="100"
                                 Height="6" Margin="0,0,0,14"/>

                    <!-- 统计 -->
                    <Border BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="10"
                            Margin="0,0,0,4">
                        <StackPanel Orientation="Horizontal">
                            <ui:TextBlock Text="文件数：" FontWeight="SemiBold"/>
                            <ui:TextBlock x:Name="StatFileCount" Text="0" Margin="6,0,18,0"/>
                            <ui:TextBlock Text="总大小：" FontWeight="SemiBold"/>
                            <ui:TextBlock x:Name="StatTotalGb" Text="0" Margin="6,0,0,0"/>
                        </StackPanel>
                    </Border>
                    <ui:TextBlock x:Name="StatProbingHint"
                                  Text="⏳ 文件大小探测中，当前总大小仅包含已探明的文件"
                                  Appearance="Tertiary"
                                  FontSize="12"
                                  Foreground="#FFE0A030"
                                  Margin="4,0,0,8"
                                  Visibility="Collapsed"/>

                    <!-- 列表（用 ListView，避免 DataGrid 看不见问题） -->
                    <Border BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                        <ListView x:Name="PageInfoListView"
                                  ItemsSource="{Binding PageInfoItems}"
                                  Height="320"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  Background="Transparent"
                                  Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                  HorizontalContentAlignment="Stretch">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="8,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="140"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel>
                                            <ui:TextBlock Text="{Binding RealName}"
                                                          FontWeight="SemiBold"
                                                          TextTrimming="CharacterEllipsis"/>
                                            <ui:TextBlock Text="{Binding Url}"
                                                          FontSize="11"
                                                          Appearance="Tertiary"
                                                          TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                            <ui:TextBlock Text="{Binding SizeGbText}" HorizontalAlignment="Right"/>
                                            <ui:TextBlock Text="{Binding SizeUnitText}"
                                                          Appearance="Tertiary"
                                                          FontSize="11"
                                                          HorizontalAlignment="Right"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Border>

                </StackPanel>
            </ui:Card>

            <!-- ===== Migrate Step1：输入源和目标数据源 ID ===== -->
            <ui:Card x:Name="MigrateStep1" Background="#ff222329" Width="520" VerticalAlignment="Center" Visibility="Collapsed">
                <StackPanel Margin="10">
                    <ui:TextBlock Text="数据源迁移" FontTypography="Subtitle" Margin="0,0,0,6"/>
                    <ui:TextBlock Text="将源数据源的所有页面按属性映射复制到目标数据源（使用数据源 ID，非数据库 ID）。"
                                  Appearance="Tertiary" TextWrapping="Wrap" Margin="0,0,0,15"/>

                    <ui:TextBlock Text="源数据源 ID" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <ui:TextBox x:Name="MigSourceIdInput" PlaceholderText="粘贴被迁移的数据源 ID" TextChanged="MigSourceId_TextChanged"/>
                    <ui:TextBlock x:Name="MigSourceIdError" Text="" FontSize="12" Margin="0,4,0,10" Foreground="#FFEF5350"/>

                    <ui:TextBlock Text="目标数据源 ID" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <ui:TextBox x:Name="MigTargetIdInput" PlaceholderText="粘贴迁移后的数据源 ID" TextChanged="MigTargetId_TextChanged"/>
                    <ui:TextBlock x:Name="MigTargetIdError" Text="" FontSize="12" Margin="0,4,0,10" Foreground="#FFEF5350"/>

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <ui:Button Content="取消" Click="CloseModal_Click"/>
                        <ui:Button x:Name="BtnMigFetchProps"
                                   Grid.Column="2"
                                   Content="获取属性"
                                   Style="{StaticResource BluePrimaryUiButton}"
                                   MinWidth="96"
                                   Click="MigFetchProperties_Click"/>
                    </Grid>
                </StackPanel>
            </ui:Card>

            <!-- ===== Migrate Step2：属性映射 ===== -->
            <ui:Card x:Name="MigrateStep2" Background="#ff222329" Width="720" VerticalAlignment="Center" MaxHeight="600" Visibility="Collapsed">
                <StackPanel Margin="10">
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <ui:TextBlock Text="属性映射" FontTypography="Subtitle" Margin="0,0,0,4"/>
                            <ui:TextBlock x:Name="MigMappingHint"
                                          Text="为源属性选择对应的目标属性，形成映射关系。只读属性（如 created_time 等）将被自动跳过。"
                                          Appearance="Tertiary" TextWrapping="Wrap"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                            <ui:Button Content="返回" Margin="0,0,8,0" Click="MigBackToStep1_Click"/>
                            <ui:Button Content="关闭" Click="CloseModal_Click"/>
                        </StackPanel>
                    </Grid>

                    <!-- 映射列表 -->
                    <Border BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="8" Margin="0,0,0,12">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="350">
                            <StackPanel x:Name="MappingPanel"/>
                        </ScrollViewer>
                    </Border>

                    <!-- 并发数 -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <ui:TextBlock Text="并发线程数：" VerticalAlignment="Center"/>
                        <ui:TextBox x:Name="MigWorkersInput" Text="3" Width="60" Margin="8,0,0,0"/>
                    </StackPanel>

                    <ui:Button x:Name="BtnMigStart"
                               Content="开始迁移"
                               Style="{StaticResource BluePrimaryUiButton}"
                               HorizontalAlignment="Right"
                               MinWidth="120"
                               Click="MigStartMigration_Click"/>
                </StackPanel>
            </ui:Card>

            <!-- ===== Migrate Step3：迁移进度 ===== -->
            <ui:Card x:Name="MigrateStep3" Background="#ff222329" Width="560" VerticalAlignment="Center" Visibility="Collapsed">
                <StackPanel Margin="10">
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <ui:TextBlock Text="迁移进度" FontTypography="Subtitle" Margin="0,0,0,4"/>
                            <ui:TextBlock x:Name="MigProgressStatus" Text="准备中…" Appearance="Tertiary"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                            <ui:Button x:Name="BtnMigCancel" Content="取消迁移" Appearance="Danger" Margin="0,0,8,0" Click="MigCancel_Click"/>
                            <ui:Button x:Name="BtnMigClose" Content="关闭" Click="CloseModal_Click"/>
                        </StackPanel>
                    </Grid>

                    <ProgressBar x:Name="MigProgressBar"
                                 Minimum="0" Maximum="100"
                                 Height="6" Margin="0,0,0,14"/>

                    <!-- 统计信息 -->
                    <Border BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <ui:TextBlock Text="总计" Appearance="Tertiary" FontSize="12"/>
                                <ui:TextBlock x:Name="MigStatTotal" Text="0" FontWeight="SemiBold" FontSize="18"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <ui:TextBlock Text="成功" Appearance="Tertiary" FontSize="12"/>
                                <ui:TextBlock x:Name="MigStatDone" Text="0" FontWeight="SemiBold" FontSize="18" Foreground="#FF4CAF50"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <ui:TextBlock Text="失败" Appearance="Tertiary" FontSize="12"/>
                                <ui:TextBlock x:Name="MigStatFailed" Text="0" FontWeight="SemiBold" FontSize="18" Foreground="#FFEF5350"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 错误列表 -->
                    <Border x:Name="MigErrorBorder"
                            BorderBrush="#44EF5350"
                            BorderThickness="1" CornerRadius="8" Padding="8"
                            Visibility="Collapsed">
                        <ScrollViewer MaxHeight="120" VerticalScrollBarVisibility="Auto">
                            <ui:TextBlock x:Name="MigErrorList"
                                          Text="" Foreground="#FFEF5350" FontSize="12"
                                          TextWrapping="Wrap"/>
                        </ScrollViewer>
                    </Border>
                </StackPanel>
            </ui:Card>

            <!-- ===== BatchSuffix Step1：输入数据源 ID 和后缀 (v1.3.0-Status) ===== -->
            <ui:Card x:Name="SuffixStep1" Background="#ff222329" Width="520" VerticalAlignment="Center" Visibility="Collapsed">
                <StackPanel Margin="10">
                    <ui:TextBlock Text="批量去除后缀" FontTypography="Subtitle" Margin="0,0,0,6"/>
                    <ui:TextBlock Text="输入数据源 ID 和要去除的后缀。程序将扫描数据源中所有页面，对标题以该后缀结尾的页面自动去除后缀。"
                                  Appearance="Tertiary" TextWrapping="Wrap" Margin="0,0,0,15"/>

                    <ui:TextBlock Text="数据源 ID" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <ui:TextBox x:Name="SuffixDsIdInput" PlaceholderText="粘贴数据源 ID" TextChanged="SuffixDsId_TextChanged"/>
                    <ui:TextBlock x:Name="SuffixDsIdError" Text="" FontSize="12" Margin="0,4,0,10" Foreground="#FFEF5350"/>

                    <ui:TextBlock Text="要去除的后缀" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <ui:TextBox x:Name="SuffixInput" PlaceholderText="例如: (1)" Margin="0,0,0,4"/>
                    <ui:TextBlock Text="提示：输入的后缀将从页面标题末尾精确匹配并移除。" Appearance="Tertiary" FontSize="12" Margin="0,0,0,10"/>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <ui:TextBlock Text="并发线程数：" VerticalAlignment="Center"/>
                        <ui:TextBox x:Name="SuffixWorkersInput" Text="3" Width="60" Margin="8,0,0,0"/>
                    </StackPanel>

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <ui:Button Content="取消" Click="CloseModal_Click"/>
                        <ui:Button x:Name="BtnSuffixStart"
                                   Grid.Column="2"
                                   Content="开始去除"
                                   Style="{StaticResource BluePrimaryUiButton}"
                                   MinWidth="96"
                                   Click="SuffixStart_Click"/>
                    </Grid>
                </StackPanel>
            </ui:Card>

            <!-- ===== BatchSuffix Step2：进度 (v1.3.0-Status) ===== -->
            <ui:Card x:Name="SuffixStep2" Background="#ff222329" Width="560" VerticalAlignment="Center" Visibility="Collapsed">
                <StackPanel Margin="10">
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <ui:TextBlock Text="批量去除后缀" FontTypography="Subtitle" Margin="0,0,0,4"/>
                            <ui:TextBlock x:Name="SuffixProgressStatus" Text="准备中…" Appearance="Tertiary"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                            <ui:Button x:Name="BtnSuffixCancel" Content="取消" Appearance="Danger" Margin="0,0,8,0" Click="SuffixCancel_Click"/>
                            <ui:Button x:Name="BtnSuffixClose" Content="关闭" Click="CloseModal_Click"/>
                        </StackPanel>
                    </Grid>

                    <ProgressBar x:Name="SuffixProgressBar"
                                 Minimum="0" Maximum="100"
                                 Height="6" Margin="0,0,0,14"/>

                    <!-- 统计信息 -->
                    <Border BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <ui:TextBlock Text="扫描" Appearance="Tertiary" FontSize="12"/>
                                <ui:TextBlock x:Name="SuffixStatScanned" Text="0" FontWeight="SemiBold" FontSize="18"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <ui:TextBlock Text="匹配" Appearance="Tertiary" FontSize="12"/>
                                <ui:TextBlock x:Name="SuffixStatTotal" Text="0" FontWeight="SemiBold" FontSize="18"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <ui:TextBlock Text="成功" Appearance="Tertiary" FontSize="12"/>
                                <ui:TextBlock x:Name="SuffixStatDone" Text="0" FontWeight="SemiBold" FontSize="18" Foreground="#FF4CAF50"/>
                            </StackPanel>

                            <StackPanel Grid.Column="3">
                                <ui:TextBlock Text="失败" Appearance="Tertiary" FontSize="12"/>
                                <ui:TextBlock x:Name="SuffixStatFailed" Text="0" FontWeight="SemiBold" FontSize="18" Foreground="#FFEF5350"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 错误列表 -->
                    <Border x:Name="SuffixErrorBorder"
                            BorderBrush="#44EF5350"
                            BorderThickness="1" CornerRadius="8" Padding="8"
                            Visibility="Collapsed">
                        <ScrollViewer MaxHeight="120" VerticalScrollBarVisibility="Auto">
                            <ui:TextBlock x:Name="SuffixErrorList"
                                          Text="" Foreground="#FFEF5350" FontSize="12"
                                          TextWrapping="Wrap"/>
                        </ScrollViewer>
                    </Border>
                </StackPanel>
            </ui:Card>

            <!-- ===== SizeUpdate Choice: 选择 自动更新 / 查询单个页面 (v1.4.0-Status) ===== -->
            <ui:Card x:Name="SizeUpdateChoice" Background="#ff222329" Width="460" VerticalAlignment="Center" Visibility="Collapsed">
                <StackPanel Margin="10">
                    <ui:TextBlock Text="Notion 页面大小自动更新/查询" FontTypography="Subtitle" Margin="0,0,0,6"/>
                    <ui:TextBlock Text="请选择操作模式。" Appearance="Tertiary" Margin="0,0,0,18"/>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <ui:Button Content="自动更新"
                                   HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                   Style="{StaticResource BluePrimaryUiButton}"
                                   Height="64"
                                   Click="SizeUpdateAutoMode_Click"/>

                        <ui:Button Grid.Column="2"
                                   Content="查询单个页面"
                                   HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                   Height="64"
                                   Click="SizeUpdateQueryMode_Click"/>
                    </Grid>

                    <ui:TextBlock Text="自动更新：扫描数据源页面文件大小并写入指定属性。&#x0a;查询单个页面：获取页面文件列表并探测大小。"
                                  Appearance="Tertiary" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,8"/>

                    <ui:Button Content="取消" HorizontalAlignment="Right" Click="CloseModal_Click"/>
                </StackPanel>
            </ui:Card>

            <!-- ===== SizeUpdate Step1: 数据源 ID + 大小属性选择 (v1.4.0-Status) ===== -->
            <ui:Card x:Name="SizeUpdateStep1" Background="#ff222329" Width="520" VerticalAlignment="Center" Visibility="Collapsed">
                <StackPanel Margin="10">
                    <ui:TextBlock Text="页面大小自动更新 — 配置" FontTypography="Subtitle" Margin="0,0,0,6"/>
                    <ui:TextBlock Text="输入数据源 ID（非数据库 ID），程序将自动获取属性列表供你选择大小属性。"
                                  Appearance="Tertiary" TextWrapping="Wrap" Margin="0,0,0,15"/>

                    <ui:TextBlock Text="数据源 ID" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <ui:TextBox x:Name="SuDsIdInput" PlaceholderText="粘贴数据源 ID" TextChanged="SuDsId_TextChanged"/>
                    <ui:TextBlock x:Name="SuDsIdError" Text="" FontSize="12" Margin="0,4,0,10" Foreground="#FFEF5350"/>

                    <ui:TextBlock Text="大小属性" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <ComboBox x:Name="SuSizePropCombo" MinWidth="200" Margin="0,0,0,4"/>
                    <ui:TextBlock Text="请选择一个数字 (number) 类型的属性用于存储页面文件总大小（GB）。如果列表为空，请先点击「获取属性」。"
                                  Appearance="Tertiary" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10"/>

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <ui:Button Content="取消" Click="CloseModal_Click"/>
                        <ui:Button x:Name="BtnSuFetchProps"
                                   Grid.Column="2"
                                   Content="获取属性"
                                   Margin="0,0,8,0"
                                   Click="SuFetchProperties_Click"/>
                        <ui:Button x:Name="BtnSuNext1"
                                   Grid.Column="3"
                                   Content="下一步"
                                   Style="{StaticResource BluePrimaryUiButton}"
                                   MinWidth="96"
                                   Click="SuNextToPageSelection_Click"/>
                    </Grid>
                </StackPanel>
            </ui:Card>

            <!-- ===== SizeUpdate Step2: 页面选择列表 (v1.4.0-Status) ===== -->
            <ui:Card x:Name="SizeUpdateStep2" Background="#ff222329" VerticalAlignment="Center"
                     Width="{Binding ActualWidth, ElementName=ModalOverlay, Converter={StaticResource ResponsiveClamp}, ConverterParameter='ratio=0.6;min=500;max=900'}"
                     MaxHeight="{Binding ActualHeight, ElementName=ModalOverlay, Converter={StaticResource ResponsiveClamp}, ConverterParameter='ratio=0.85;min=360;max=820'}"
                     Visibility="Collapsed">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 标题栏 -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <ui:TextBlock Text="选择要更新的页面" FontTypography="Subtitle" Margin="0,0,0,4"/>
                            <ui:TextBlock x:Name="SuPageCountHint" Text="共 0 个页面" Appearance="Tertiary"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                            <ui:Button Content="返回" Margin="0,0,8,0" Click="SuBackToStep1_Click"/>
                            <ui:Button Content="关闭" Click="CloseModal_Click"/>
                        </StackPanel>
                    </Grid>

                    <!-- 页面列表 (两个分类) -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- 未设置大小的页面 -->
                            <Border BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                                    BorderThickness="1" CornerRadius="8" Padding="8" Margin="0,0,0,10">
                                <StackPanel>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <ui:TextBlock x:Name="SuEmptyHeader" Text="未设置大小 (0)" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <ui:Button Grid.Column="1" Content="全选" Margin="0,0,4,0" FontSize="12" Padding="8,2"
                                                   Click="SuSelectAllEmpty_Click"/>
                                        <ui:Button Grid.Column="2" Content="反选" FontSize="12" Padding="8,2"
                                                   Click="SuDeselectAllEmpty_Click"/>
                                    </Grid>
                                    <StackPanel x:Name="SuEmptyPagesPanel"/>
                                </StackPanel>
                            </Border>

                            <!-- 已设置大小的页面 -->
                            <Border BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                                    BorderThickness="1" CornerRadius="8" Padding="8" Margin="0,0,0,10">
                                <StackPanel>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <ui:TextBlock x:Name="SuSetHeader" Text="已设置大小 (0)" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <ui:Button Grid.Column="1" Content="全选" Margin="0,0,4,0" FontSize="12" Padding="8,2"
                                                   Click="SuSelectAllSet_Click"/>
                                        <ui:Button Grid.Column="2" Content="反选" FontSize="12" Padding="8,2"
                                                   Click="SuDeselectAllSet_Click"/>
                                    </Grid>
                                    <StackPanel x:Name="SuSetPagesPanel"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- 线程设置 + 开始按钮 -->
                    <StackPanel Grid.Row="2" Margin="0,10,0,0">
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="24"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <ui:TextBlock Text="链接查询线程：" VerticalAlignment="Center"/>
                            <ui:TextBox x:Name="SuLinkWorkersInput" Grid.Column="1" Text="3" Width="50" Margin="4,0,0,0"/>

                            <ui:TextBlock Grid.Column="3" Text="大小查询线程：" VerticalAlignment="Center"/>
                            <ui:TextBox x:Name="SuSizeWorkersInput" Grid.Column="4" Text="5" Width="50" Margin="4,0,0,0"/>
                        </Grid>

                        <ui:TextBlock Text="⚠️ 由于 Notion API 速率限制（3 请求/秒），链接查询线程不宜过大。下载链接（HEAD 请求）无限制。"
                                      Appearance="Tertiary" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10"/>

                        <ui:Button x:Name="BtnSuStartUpdate"
                                   Content="开始更新"
                                   Style="{StaticResource BluePrimaryUiButton}"
                                   HorizontalAlignment="Right"
                                   MinWidth="120"
                                   Click="SuStartUpdate_Click"/>
                    </StackPanel>
                </Grid>
            </ui:Card>

            <!-- ===== SizeUpdate Step3: 进度 (v1.4.0-Status) ===== -->
            <ui:Card x:Name="SizeUpdateStep3" Background="#ff222329" Width="600" VerticalAlignment="Center" Visibility="Collapsed">
                <StackPanel Margin="10">
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <ui:TextBlock Text="页面大小更新进度" FontTypography="Subtitle" Margin="0,0,0,4"/>
                            <ui:TextBlock x:Name="SuProgressStatus" Text="准备中…" Appearance="Tertiary"/>
                            <ui:TextBlock x:Name="SuElapsedText" Text="" Appearance="Tertiary" FontSize="12" Margin="0,2,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                            <ui:Button x:Name="BtnSuCancel" Content="取消" Appearance="Danger" Margin="0,0,8,0" Click="SuCancel_Click"/>
                            <ui:Button x:Name="BtnSuClose" Content="关闭" Click="CloseModal_Click"/>
                        </StackPanel>
                    </Grid>

                    <ProgressBar x:Name="SuProgressBar"
                                 Minimum="0" Maximum="100"
                                 Height="6" Margin="0,0,0,14"/>

                    <!-- 统计信息 -->
                    <Border BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                        <StackPanel>
                            <!-- 页面级统计 -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <ui:TextBlock Text="总计页面" Appearance="Tertiary" FontSize="12"/>
                                    <ui:TextBlock x:Name="SuStatTotal" Text="0" FontWeight="SemiBold" FontSize="18"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1">
                                    <ui:TextBlock Text="链接已查询" Appearance="Tertiary" FontSize="12"/>
                                    <ui:TextBlock x:Name="SuStatLinkQueried" Text="0" FontWeight="SemiBold" FontSize="18"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <ui:TextBlock Text="已更新" Appearance="Tertiary" FontSize="12"/>
                                    <ui:TextBlock x:Name="SuStatUpdated" Text="0" FontWeight="SemiBold" FontSize="18" Foreground="#FF4CAF50"/>
                                </StackPanel>

                                <StackPanel Grid.Column="3">
                                    <ui:TextBlock Text="失败" Appearance="Tertiary" FontSize="12"/>
                                    <ui:TextBlock x:Name="SuStatFailed" Text="0" FontWeight="SemiBold" FontSize="18" Foreground="#FFEF5350"/>
                                </StackPanel>
                            </Grid>

                            <!-- 文件级统计（流式） -->
                            <Border BorderThickness="0,1,0,0"
                                    BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                                    Margin="0,8,0,0" Padding="0,8,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel>
                                        <ui:TextBlock Text="文件发现" Appearance="Tertiary" FontSize="12"/>
                                        <ui:TextBlock x:Name="SuStatFilesDiscovered" Text="0" FontWeight="SemiBold" FontSize="16"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1">
                                        <ui:TextBlock Text="文件已探测" Appearance="Tertiary" FontSize="12"/>
                                        <ui:TextBlock x:Name="SuStatFilesProbed" Text="0" FontWeight="SemiBold" FontSize="16"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- 错误列表 -->
                    <Border x:Name="SuErrorBorder"
                            BorderBrush="#44EF5350"
                            BorderThickness="1" CornerRadius="8" Padding="8"
                            Visibility="Collapsed">
                        <ScrollViewer MaxHeight="120" VerticalScrollBarVisibility="Auto">
                            <ui:TextBlock x:Name="SuErrorList"
                                          Text="" Foreground="#FFEF5350" FontSize="12"
                                          TextWrapping="Wrap"/>
                        </ScrollViewer>
                    </Border>
                </StackPanel>
            </ui:Card>

        </Grid>
    </Grid>
</Page>
